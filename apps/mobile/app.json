{
  "expo": {
    "name": "Munchkin Tracker",
    "slug": "munchkin-tracker",
    "version": "1.0.0",
    "scheme": "munchkin",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
